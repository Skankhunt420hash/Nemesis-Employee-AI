# Beispiel fuer /opt/nemesis/.env  (KEINE echten Werte in Git!)
# Betreiber-Zugang (>= 16 Zeichen, zufaellig): https://<domain>/k/<NEMESIS_ZUGANG>/zentrale
NEMESIS_ZUGANG=
# Selbst-Update von GitHub main abschalten (empfohlen; Updates dann bewusst per install-app.sh)
NEMESIS_AUTO_UPDATE=0
# Agenten-Sandbox: auto | docker | aus
NEMESIS_SANDBOX=auto
NEMESIS_SANDBOX_BILD=node:22
# Optional: fester Tresor-Schluessel (64 Hex-Zeichen, openssl rand -hex 32). Getrennt sichern!
NEMESIS_TRESOR_SCHLUESSEL=
# Gratis-Modellanbieter (offizielle APIs). Auch ueber Lab -> KI-Schluessel setzbar.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
# Optional, kostenpflichtig: wird NUR nach Freigabe unter Zentrale -> Modelle & Kosten genutzt
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
